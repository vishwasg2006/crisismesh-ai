# Copy to .env  (PowerShell: copy .env.example .env)
#PORT=4000
#NODE_ID=hq-node-1

# Folder with the dashboards (served at /app/). Relative to where you start the backend.
FRONTEND_DIR=../frontend

# auto = try MySQL, fall back to JSON file if MySQL is not reachable
# mysql = require MySQL | json = JSON file only (no DB needed)
STORE=json

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=1234
MYSQL_DATABASE=crisismesh

JSON_PATH=./data/store.json

# Local LLM (Ollama). If it is not running, rule-based agents are used automatically.
OLLAMA_ENABLED=true
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_MS=15000

# Reports older than this (minutes) are flagged stale
STALE_MIN=180

# ---- login / roles ----
# AUTH_ENABLED=false turns the login off completely (open access)
#AUTH_ENABLED=true
#AUTH_SECRET=change-me            # use the same value on both laptops in the split-brain demo
#COORDINATOR_CODE=APEX-COORD      # code needed to self-register as coordinator
